configuration {
    modi:                "drun,filebrowser,window,run";
    show-icons:          true;
    drun-display-format: "{name}";

    display-drun:        " ";
    display-run:         " ";
    display-filebrowser: " ";
    display-window:      " ";

    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    icon-theme:          "Papirus-Light";

    matching:            "prefix";
    tokenize:            false;
    case-sensitive:      false;
    sort:                true;
    sorting-method:      "levenshtein";
}

/*======== Palette: mirrors ~/.config/waybar/tokens/colors.css (matugen) ========*/
* {
    font:                       "JetBrainsMono Nerd Font 11";

    surface:                    #0f1416;
    surface-container:          #1b2023;
    surface-container-high:     #252b2d;
    surface-container-highest:  #303638;
    on-surface:                 #dee3e6;
    on-surface-variant:         #bfc8cc;
    primary:                    #88d1ec;
    on-primary:                 #003544;
    secondary-fixed-dim:        #b3cad4;
    tertiary:                   #c3c3eb;
    outline:                    #8a9296;
    outline-variant:            #40484c;
}

/*======== Window ========*/
window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @surface;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    20px;
}

mainbox {
    orientation:      horizontal;
    background-color: transparent;
    children:         [ "leftbox", "mode-switcher" ];
}

leftbox {
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/*======== Search pill (same look as the bar modules) ========*/
inputbar {
    enabled:          true;
    margin:           20px 20px 0px 20px;
    padding:          12px 16px;
    spacing:          8px;
    background-color: @surface-container;
    border-radius:    20px;
    children:         [ "prompt", "entry" ];
}

entry {
    background-color:  transparent;
    text-color:        @on-surface;
    placeholder:       "Search...";
    placeholder-color: @outline;
    padding:           0;
}

prompt {
    background-color: transparent;
    text-color:       @primary;
}

/*======== Results ========*/
listview {
    background-color: transparent;
    columns:          4;
    lines:            3;
    spacing:          10px;
    padding:          10px 20px 20px 20px;
    fixed-columns:    true;
    fixed-height:     true;
    cycle:            false;
}

element {
    orientation:      vertical;
    padding:          10px;
    border-radius:    16px;
    spacing:          10px;
    background-color: transparent;
    text-color:       @secondary-fixed-dim;
    children:         [ element-icon, element-text ];
}

/* Selected = active workspace look: primary pill, black text */
element selected {
    background-color: @primary;
    text-color:       #000000;
}

element-icon {
    background-color: transparent;
    size:             64px;
    horizontal-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
}

/*======== Mode dock ========*/
mode-switcher {
    background-color: @surface-container;
    width:            85px;
    padding:          60px 10px;
    spacing:          20px;
    border-radius:    0 20px 20px 0;
    orientation:      vertical;
    children:         [ button ];
}

button {
    background-color: @surface-container-highest;
    text-color:       @tertiary;
    border-radius:    50px;
    padding:          14px 0px;
    cursor:           pointer;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

button selected {
    background-color: @primary;
    text-color:       @on-primary;
}
